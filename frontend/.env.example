# Base URL of the .NET spot-price API. Defaults to the `http` launch profile.
# Copy to `.env` (or `.env.local`) to override.
VITE_API_BASE_URL=http://localhost:5262


# Base URL baked into the Shelly scripts the wizard generates. It is read by the *device*, not the
# browser, so during local testing it must be this machine's LAN address rather than localhost:
# a Shelly's "localhost" is itself. Same value as above once deployed.
#
# DEVELOPMENT ONLY. The value below is a non-working placeholder; put your LAN address in
# .env.local. A production build refuses private or plaintext http:// addresses here (see
# src/shelly/generate.ts): whoever answers on that host can rewrite a user's boiler schedule.
VITE_DEVICE_API_BASE_URL=http://192.0.2.1:5262
